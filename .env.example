# VulcanShield Platform Environment Configuration
# Copy this file to .env for local development

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=vulcan
POSTGRES_PASSWORD=vulcanpass
POSTGRES_DB=vulcanshield

# Real-Time State (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Event Streaming (Kafka)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=transaction.created
KAFKA_TOPIC_RISK=risk.evaluated
KAFKA_TOPIC_DECISIONS=transaction.decisioned
KAFKA_TOPIC_INVESTIGATIONS=ai.investigation.requested

# AI Model Server (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Go Backend Service
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080

# Next.js Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Python ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

# Python AI Service
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai-service:8001
